DATABASE_URL="file:./dev.db"

# Single-password auth for the web UI. Pick any strong password.
SESSION_PASSWORD=change-me
# Random 32+ char string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-hex-string

# Twilio — from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Public base URL for Twilio webhook (e.g. https://<your-ngrok>.ngrok.app)
PUBLIC_BASE_URL=http://localhost:3000

# Minutes to wait for a reply before moving to the next sitter
REPLY_TIMEOUT_MINUTES=30

# Optional signature for Twilio webhook validation (defaults to validating)
VALIDATE_TWILIO_SIGNATURE=true
