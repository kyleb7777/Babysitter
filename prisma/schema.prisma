generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sitter {
  id                 String     @id @default(cuid())
  name               String
  phone              String     @unique
  availability       String     // free-form notes, e.g. "Fri/Sat evenings"
  weeklyAvailability Json?      // structured per-day availability; see lib/availability.ts
  priority           Int        @default(5) // 1-10, higher = asked first
  rate               String?    // free-form, e.g. "$25/hr"
  active             Boolean    @default(true)
  createdAt          DateTime   @default(now())
  outreaches         Outreach[]
}

model SitterRequest {
  id               String     @id @default(cuid())
  date             String     // ISO date e.g. 2026-05-02
  timeWindow       String     // display label, e.g. "6-10pm" (computed from start/end)
  startTime        String?    // HH:MM local time, e.g. "18:00"
  endTime          String?    // HH:MM local time, e.g. "22:00"
  timeoutMinutes   Int        @default(30) // minutes to wait for a reply before moving on
  notes            String?
  calendarEventUid String?    // links back to a Google Calendar event (if created from /calendar)
  status           String     @default("PENDING") // PENDING | FILLED | EXHAUSTED | CANCELLED
  filledById       String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  outreaches       Outreach[]

  @@index([calendarEventUid])
}

model DismissedEvent {
  eventUid    String   @id
  dismissedAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Outreach {
  id          String        @id @default(cuid())
  requestId   String
  sitterId    String
  status      String        @default("QUEUED") // QUEUED | SENT | YES | NO | MAYBE | TIMEOUT | ERROR
  sentAt      DateTime?
  repliedAt   DateTime?
  replyBody   String?
  errorText   String?
  order       Int
  request     SitterRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sitter      Sitter        @relation(fields: [sitterId], references: [id])

  @@unique([requestId, sitterId])
  @@index([requestId, order])
}
